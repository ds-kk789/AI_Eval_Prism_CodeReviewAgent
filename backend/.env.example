# Copy to .env and fill in. Key names only: never commit real values, never log them.

# --- LLM (same key names as AuditLens) ---
# Agents (Reviewer, baseline): Gemini 3.5 Flash-Lite. Limits are per Google Cloud project, not per key.
GOOGLE_API_KEY=your_google_api_key
# DeepEval judge: Groq gpt-oss-120b, account 1. Limits are per Groq organization.
GROQ_API_KEY=your_groq_api_key
# Backup: Groq account 2 (a separate organization, so a separate quota).
GROQ_API_KEY_2=
# 0 during evaluation runs, so one model family is measured consistently.
LLM_FALLBACK=0

# --- PRism ---
# v0 = flawed build with planted weaknesses, v1 = hardened build.
PRISM_BUILD=v1
# Reviewer prompt for the A/B test: vA or vB.
PRISM_PROMPT=vA
